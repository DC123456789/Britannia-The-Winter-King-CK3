# Required controller: decision_option_list_controller

vbox = {
	name = "decision_view_expand_archdiocese_canterbury"
	ClericalRegionExpansionWidget = {
		blockoverride "box_datamodel" {
			datamodel = "[GetTitleByKey('d_et_canterbury').MakeScope.GetList('clerical_title_expansions')]"
		}
		blockoverride "no_titles_text_is_shown" {
			visible = "[GetScriptedGui('BTWK_expand_clerical_titles_none_shown').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('archbishopric_title', GetTitleByKey('d_et_canterbury').MakeScope).End)]"
		}
	}
}