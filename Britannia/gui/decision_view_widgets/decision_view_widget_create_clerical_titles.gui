# Required controller: decision_option_list_controller

vbox = {
	name = "decision_view_widget_create_clerical_titles"
	TitleSelectionActionBoxType = {
		blockoverride "box_datamodel" {
			datamodel = "[GetGlobalList('creatable_clerical_title_stories')]"
		}
		blockoverride "no_titles_text" {
			text = BTWK_create_clerical_titles_decision_no_title_shown_string
		}
		blockoverride "no_titles_text_is_shown" {
			visible = "[GetScriptedGui('BTWK_create_clerical_titles_none_shown').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		}
		blockoverride "title_visible" {
			visible = "[GetScriptedGui('BTWK_create_clerical_titles_show').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scoped_title', Scope.Story.MakeScope).End)]"
		}
		blockoverride "title_button_text" {
			text = BTWK_create_clerical_titles_button_title_name
		}
		blockoverride "title_button" {
			onclick = "[GetScriptedGui('title_selection_decision_selection').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scoped_title', Scope.Story.MakeScope).End)]"
			down = "[GetScriptedGui('title_selection_decision_is_selected').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scoped_title', Scope.Story.MakeScope).End)]"
		}
		blockoverride "title_button_coa_type" {
			coa_title_tiny = {
				block "title_button_coa" {
					datacontext = "[Scope.Var('coa_title').Title]"
				}
				# Prevents the CoA from being clickable
				blockoverride "coa_button" { }
				blockoverride "coa_hover_glow_visible" { visible = no }
			}
		}
		blockoverride "title_button_box_datacontext" {
			datacontext = "[Scope.Story]"
		}
		blockoverride "title_select_button_box_datacontext" {
			datacontext = "[Scope.Var('title').Title]"
		}
		blockoverride "selection_button" {
			onclick = "[GetScriptedGui('BTWK_create_clerical_titles_create').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scoped_title', Scope.Story.MakeScope).End)]"
			enabled = "[GetScriptedGui('BTWK_create_clerical_titles_create').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scoped_title', Scope.Story.MakeScope).End)]"
			tooltip = "[GetScriptedGui('BTWK_create_clerical_titles_create').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scoped_title', Scope.Story.MakeScope).End)]"
		}
		blockoverride "selection_button_text_box" {
			margin_left = 13
		}
		blockoverride "selection_button_text" {
			text = "Create"
		}
	}
}