
types TitleSelectionActionTypes
{
	type ClericalRegionExpansionWidget = TitleSelectionActionBoxType {
		blockoverride "no_titles_text" {
			text = BTWK_expand_clerical_titles_decision_no_title_shown_string
		}
		blockoverride "no_titles_text_is_shown" {
			visible = "[GetScriptedGui('BTWK_expand_clerical_titles_none_shown').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('archbishopric_title', GetTitleByKey('d_et_canterbury').MakeScope).End)]"
		}
		blockoverride "title_visible" {
			visible = "[GetScriptedGui('BTWK_expand_clerical_titles_show').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scoped_title', Scope.Story.MakeScope).End)]"
		}
		blockoverride "title_button_text" {
			text = BTWK_expand_clerical_titles_button_title_name
		}
		blockoverride "title_button" {
			onclick = "[GetScriptedGui('title_selection_decision_selection').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scoped_title', Scope.Story.MakeScope).End)]"
			down = "[GetScriptedGui('title_selection_decision_is_selected').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scoped_title', Scope.Story.MakeScope).End)]"
		}
		blockoverride "title_button_coa" {
			datacontext = "[Scope.Var('title').Var('clerical_title').Title]"
		}
		blockoverride "title_button_box_datacontext" {
			datacontext = "[Scope.Var('region').GeographicalRegion]"
		}
		blockoverride "title_select_button_box_datacontext" {
			datacontext = "[Scope.Var('title').Title]"
		}
		blockoverride "selection_button" {
			onclick = "[GetScriptedGui('BTWK_expand_clerical_titles_expand').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scoped_title', Scope.Story.MakeScope).End)]"
			enabled = "[GetScriptedGui('BTWK_expand_clerical_titles_expand').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scoped_title', Scope.Story.MakeScope).End)]"
			tooltip = "[GetScriptedGui('BTWK_expand_clerical_titles_expand').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scoped_title', Scope.Story.MakeScope).End)]"
		}
		blockoverride "selection_button_text_box" {
			margin_left = 6
		}
		blockoverride "selection_button_text" {
			text = "Integrate"
		}
	}

	type TitleSelectionActionBoxType = vbox {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		ignoreinvisible = yes

		margin_top = 10
		spacing = 10

		vbox = {		
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			scrollbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				
				size = { 400 200 }

				blockoverride "scrollbox_content" {
					vbox = {
						block "box_datamodel" {
						}
						spacing = 6

						item = {
							TitleSelectionActionTitleType = {
							}
						}
					}
						
					text_single = {
						name = "no_titles_text_display"
						alwaystransparent = yes
						block "no_titles_text" {
							text = no_title_shown_string
						}
						max_width = 350
						align = center
						block "no_titles_text_is_shown" {
						}
					}
				}
			}
		}
		
		state = {
			name = init_state
			trigger_on_create = yes
			block "box_create_state" {
				on_start = "[GetScriptedGui('title_selection_decision_reset_selection').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
		}
		
		state = {
			name = init_state
			trigger_on_create = yes
			block "box_create_state_secondary" {
			}
		}
	}
	
	type TitleSelectionActionTitleType = hbox {
		#layoutpolicy_horizontal = expanding		# Causes slight alignment bug for some reason
		layoutpolicy_vertical = expanding
		# spacing = 6		# This doesn't work for the last element in the list (????) so we instead have an invisible widget between the buttons
		
		block "title_visible" {
		}
		
		button_standard = {
			block "title_button_size" {
				size = { 284 50 }
				margin = { 10 10 }
			}

			block "title_button" {
				onclick = "[GetScriptedGui('title_selection_decision_selection').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scoped_title', Scope.Title.MakeScope).End)]"
				# enabled = "[GetScriptedGui('title_selection_decision_selection').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scoped_title', Scope.Title.MakeScope).End)]"
				# tooltip = "[Entry.GetTooltip]"
				down = "[GetScriptedGui('title_selection_decision_is_selected').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('scoped_title', Scope.Title.MakeScope).End)]"
			}
			
			hbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				spacing = 10
				margin_left = 10

				vbox = {
					layoutpolicy_vertical = expanding
					margin_top = 12
					block "title_button_coa_type" {
						coa_title_tiny = {
							block "title_button_coa" {
								datacontext = "[Scope.Title]"
							}
						}
					}
				}

				vbox = {
					block "title_button_box_datacontext" {
						datacontext = "[Scope.Title]"
					}
					name = "title_info"
					layoutpolicy_vertical = expanding
					margin_bottom = 5

					text_single = {
						name = "title_name"
						alwaystransparent = yes
						block "title_button_text" {
							text = "[Title.GetName]"
						}
						max_width = 250
						align = left
					}
				}
				
				expand = {}
			}
		}
		
		hbox = {
			widget = {
				block "spacing_hbox_size" {
					size = { 6 50 }
				}
			}
		}
		
		button_standard = {
			block "selection_button_size" {
				size = { 70 50 }
				margin = { 10 10 }
			}

			block "selection_button" {
			}
			
			hbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				spacing = 10
				block "selection_button_text_box" {
					margin_left = 10
				}

				vbox = {
					block "title_select_button_box_datacontext" {
						datacontext = "[Scope.Title]"
					}
					name = "title_info"
					layoutpolicy_vertical = expanding
					margin_bottom = 5

					text_single = {
						name = "title_name"
						alwaystransparent = yes
						block "selection_button_text" {
							text = "Select"
						}
						max_width = 250
						align = center
					}
				}
				
				expand = {}
			}
		}
	}
}