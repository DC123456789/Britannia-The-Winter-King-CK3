vbox = {
	name = "decision_view_expand_archdiocese_st_davids"
	ClericalRegionExpansionWidget = {
		blockoverride "box_datamodel" {
			datamodel = "[GetGlobalList('briton_clerical_title_expansion_stories')]"
		}
		blockoverride "no_titles_text_is_shown" {
			visible = "[GetScriptedGui('BTWK_expand_clerical_titles_st_davids_none_shown').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		}
	}
}